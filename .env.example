VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# Public app URL used in staff invite emails (production: https://efin.money)
VITE_APP_URL="https://efin.money"
# Stripe publishable key (safe to expose in the browser)
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Public Adyen client key (test/live) — used after 3DS redirect return
VITE_ADYEN_CLIENT_KEY="test_..."
VITE_ADYEN_ENV="test"
# Optional: open top-up with Flutterwave pre-selected (USD/CAD only)
# /wallet/topup?provider=flutterwave&currency=CAD
# VITE_FLW_WESTERN_TOPUP="true"  # default provider = Flutterwave for USD/CAD
# Set to true when Paysafe production credentials are live (enables EFT + Interac in Canada send + claim).
# VITE_PAYSAFE_PAYOUTS_ENABLED="true"
