VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-publishable-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
# Public app URL used in staff invite emails (production: https://efin.money)
VITE_APP_URL="https://efin.money"
# Stripe publishable key (safe to expose in the browser)
VITE_STRIPE_PUBLISHABLE_KEY="pk_live_..."
# Public Adyen client key (test/live) — used after 3DS redirect return
VITE_ADYEN_CLIENT_KEY="test_..."
VITE_ADYEN_ENV="test"
# Optional: open top-up with Flutterwave pre-selected (USD/CAD only)
# /wallet/topup?provider=flutterwave&currency=CAD
# VITE_FLW_WESTERN_TOPUP="true"  # default provider = Flutterwave for USD/CAD
# Set to true when Paysafe production credentials are live (enables EFT + Interac in Canada send + claim).
# VITE_PAYSAFE_PAYOUTS_ENABLED="true"
# Alice AI assistant: shown on user + admin ends by default. Set to "false" to hide it everywhere.
# VITE_ALICE_ENABLED="true"
# Ghana MoMo (lenhub) — set in Supabase Edge secrets for production:
# GHANA_PAY_API_URL=https://mtn.lenhub.net
# GHANA_PAY_USER=Efinmoney
# GHANA_PAY_WEBHOOK_SECRET=optional
# Nomba (Nigeria/international) — reuses GHANA_PAY_* if NOMBA_PAY_* unset
# NOMBA_PAY_API_URL=https://mtn.lenhub.net
# NOMBA_PAY_USER=Efinmoney
# Nigeria bank rail paths (defaults match payment.json / lenhub)
# NOMBA_NIGERIA_BANKCODE_PATH=/api/efin/nigeria/bankcode
# NOMBA_NIGERIA_LOOKUP_PATH=/api/efin/nigeria/account/lookup
# NOMBA_EXCHANGE_PATH=/api/efin/exchange/
# NOMBA_NIGERIA_TRANSFER_PATH=/api/efin/nigeria/transfer
# NOMBA_NIGERIA_CONVERSION_PATH=/api/efin/nigeria/transfer/conversion
# NOTE: lenhub transfer + conversion require valid upstream JWT — coordinate with provider if payouts fail with JWT expired.
#
# UI feature flags (override defaults in src/lib/productFeatures.ts)
# VITE_FEATURE_NOMBA_NIGERIA="true"
# VITE_FEATURE_GHANA_PAY="true"
# VITE_FEATURE_PLAID="true"
# VITE_FEATURE_CANADA_DOMESTIC="false"
# VITE_FEATURE_STRIPE="false"
# VITE_FEATURE_FLUTTERWAVE="true"  # enables Flutterwave UI (TZS MoMo via V4)
# VITE_FEATURE_LENHUB_FLUTTER="true"  # lenhub /v1/flutterwave/flutter card collect + FX payouts
# Lenhub Flutter wrapper (set on Supabase Edge):
# LENHUB_FLUTTER_API_URL=https://efincash.lenhub.net
# LENHUB_FLUTTER_USER_KEY=   # tenant API key from Lenhub (Fernet session via /auth/user_api/)
# LENHUB_FLUTTER_ENABLED=true
# LENHUB_FLUTTER_PAYOUT=true
# LENHUB_FLUTTER_WEBHOOK_URL=https://efin-flw-proxy.ukwenzyb.workers.dev/webhooks/lenhub-flutter
# Flutterwave V4 (company account) — set in Supabase Edge secrets:
# FLW_CLIENT_ID=...
# FLW_CLIENT_SECRET=...
# FLW_ENCRYPTION_KEY=...
# FLW_V4_ENV=live
# FLW_WEBHOOK_HASH=your-dashboard-webhook-secret
# Legacy V3 (optional fallback if V4 not set): FLW_SECRET_KEY=FLWSECK-...
# Note: Flutterwave v4 uses Client ID + Client Secret (OAuth). This app prefers V4 when FLW_CLIENT_ID is set.
# VITE_FEATURE_CRYPTO="false"
# VITE_FEATURE_BILL_PAY="false"
# VITE_FEATURE_PAYMENT_LINKS="false"
# VITE_FEATURE_OTHER_AFRICA="false"
# VITE_FEATURE_CARDS="false"
# VITE_FEATURE_ADYEN="false"
