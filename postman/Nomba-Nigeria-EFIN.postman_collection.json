{
  "info": {
    "name": "Nomba Nigeria — EFIN APIs (lenhub)",
    "description": "Direct tests against https://mtn.lenhub.net for provider escalation.\n\nScreenshot for lenhub:\n- ✅ Tests 1–3 (working)\n- ❌ Tests 5–6 (JWT expired on transfer/conversion)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://mtn.lenhub.net" },
    { "key": "merchantUser", "value": "Efinmoney" },
    { "key": "testEmail", "value": "test@efin.money" },
    { "key": "callbackUrl", "value": "https://dkdnwumllibwdlqbjkwy.functions.supabase.co/nomba-payment-callback" }
  ],
  "item": [
    {
      "name": "1. GET Bank codes (WORKS)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/api/efin/nigeria/bankcode"
      }
    },
    {
      "name": "2. GET Account lookup (WORKS)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/efin/nigeria/account/lookup?account_number=0123456789&bankcode=058",
          "host": ["{{baseUrl}}"],
          "path": ["api", "efin", "nigeria", "account", "lookup"],
          "query": [
            { "key": "account_number", "value": "0123456789" },
            { "key": "bankcode", "value": "058", "description": "GTBank code from bank list" }
          ]
        }
      }
    },
    {
      "name": "3. GET Exchange rate USD→NGN (WORKS)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/efin/exchange/?from_dat=USD&to=NGN",
          "host": ["{{baseUrl}}"],
          "path": ["api", "efin", "exchange", ""],
          "query": [
            { "key": "from_dat", "value": "USD" },
            { "key": "to", "value": "NGN" }
          ]
        }
      }
    },
    {
      "name": "4. POST Collection Nigeria (WORKS)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Accept", "value": "application/json" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currency\": \"NGN\",\n  \"amount\": \"100\",\n  \"user\": \"{{merchantUser}}\",\n  \"callback\": \"{{callbackUrl}}\",\n  \"email\": \"{{testEmail}}\"\n}"
        },
        "url": "{{baseUrl}}/api/efin/payment/collection/nigeria"
      }
    },
    {
      "name": "5. POST Transfer conversion (JWT FAIL)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/efin/nigeria/transfer/conversion?amount=100&from_currency=USD&to_currency=NGN",
          "host": ["{{baseUrl}}"],
          "path": ["api", "efin", "nigeria", "transfer", "conversion"],
          "query": [
            { "key": "amount", "value": "100" },
            { "key": "from_currency", "value": "USD" },
            { "key": "to_currency", "value": "NGN" }
          ]
        }
      }
    },
    {
      "name": "6. POST Bank transfer (JWT FAIL)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": {
          "raw": "{{baseUrl}}/api/efin/nigeria/transfer?amount=100&account_number=0123456789&bankcode=058&account_name=Postman%20Test&ref_text=postman-jwt-test-001&narrative=Postman%20JWT%20escalation%20test",
          "host": ["{{baseUrl}}"],
          "path": ["api", "efin", "nigeria", "transfer"],
          "query": [
            { "key": "amount", "value": "100" },
            { "key": "account_number", "value": "0123456789" },
            { "key": "bankcode", "value": "058" },
            { "key": "account_name", "value": "Postman Test" },
            { "key": "ref_text", "value": "postman-jwt-test-001" },
            { "key": "narrative", "value": "Postman JWT escalation test" }
          ]
        }
      }
    }
  ]
}
