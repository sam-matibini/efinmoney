# Paytota test credentials — copy to scripts/.paytota.env (gitignored)
# Get keys from https://gate.paytota.com/login → Developers

PAYTOTA_BASE_URL=https://gate.paytota.com
PAYTOTA_SECRET_KEY=
PAYTOTA_BRAND_ID=
PAYTOTA_TEST_EMAIL=test@efin.money
PAYTOTA_TEST_PHONE=256770123456
# UGX MoMo payout smoke target (partner test wallet)
PAYTOTA_TEST_PAYOUT_PHONE=256779735042

# --- Supabase secrets (eFintax project dkdnwumllibwdlqbjkwy) ---
# After `npx supabase login` with the eFintax owner account:
#
#   npx supabase secrets set \
#     PAYTOTA_SECRET_KEY="..." \
#     PAYTOTA_BRAND_ID="11210fe6-5281-404c-9b5a-573698b288e7" \
#     PAYTOTA_BASE_URL="https://gate.paytota.com" \
#     PAYTOTA_PAYOUT_ENABLED="true" \
#     --project-ref dkdnwumllibwdlqbjkwy
#
#   npx supabase db query --linked -f supabase/migrations/20260719190000_paytota_payout.sql --yes
#   npx supabase functions deploy paytota-payout execute-transfer --project-ref dkdnwumllibwdlqbjkwy
#
# Frontend:
#   VITE_FEATURE_PAYTOTA=true          → USD/EUR/GBP/CAD top-up via Paytota invoice
#   VITE_FEATURE_PAYTOTA_PAYOUT=true   → Send page "Use Paytota (test)" for UGX MoMo
#
# Smoke payout (initiate only by default):
#   node scripts/paytota-smoke-test.mjs --payout-only
#   node scripts/paytota-smoke-test.mjs --payout-only --execute
#
# Note: execute may return "terminal disabled" until Paytota enables MTN/Airtel
# terminals on the merchant account. Payload path is POST /po/{id}/{mtnmomo|airtel}/
# with body { "phone": "..." }.
