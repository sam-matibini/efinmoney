# Copy to scripts/.swychr.env (gitignored) or export in your shell before smoke tests.
# Also set these as Supabase Edge Function secrets.

SWYCHR_ENABLED=true
SWYCHR_EMAIL=your-swychr-admin@email.com
SWYCHR_PASSWORD=your-password

# Optional: per-suite overrides if Swychr gave separate logins
# SWYCHR_PAYIN_EMAIL=
# SWYCHR_PAYIN_PASSWORD=
# SWYCHR_PAYOUT_EMAIL=
# SWYCHR_PAYOUT_PASSWORD=
# SWYCHR_CARD_EMAIL=
# SWYCHR_CARD_PASSWORD=
# SWYCHR_AIRTIME_EMAIL=
# SWYCHR_AIRTIME_PASSWORD=

# Payin webhook signature (X-Swychr-Signature)
# SWYCHR_WEBHOOK_SECRET=

# Cards: use sandbox until go-live
SWYCHR_CARD_SANDBOX=true

# After Nomba payout fails, try Swychr
SWYCHR_PAYOUT_FALLBACK=true
