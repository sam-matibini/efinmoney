# Copy to scripts/.elicate.env (gitignored) for local smoke tests.
# Also set matching secrets on Supabase Edge Functions.

ELICATE_ENV=live
ELICATE_LIVE_BASE_URL=https://elicatepay.vercel.app
ELICATE_LIVE_SECRET_KEY=ep_live_sk_your_key
ELICATE_LIVE_PUBLIC_KEY=ep_live_pk_your_key
ELICATE_LIVE_WEBHOOK_SECRET=your-webhook-secret

# Sandbox (when ELICATE_ENV=sandbox):
# ELICATE_SECRET_KEY=ep_test_sk_...
# ELICATE_PUBLIC_KEY=ep_test_pk_...
# ELICATE_WEBHOOK_SECRET=...
